# Reddit OAuth2 credentials
# Create an app at https://www.reddit.com/prefs/apps
# Select "web app" type, set redirect URI to http://localhost:3000/api/auth/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# After completing OAuth flow, the refresh token is stored server-side.
# See /api/auth/callback for the flow.
